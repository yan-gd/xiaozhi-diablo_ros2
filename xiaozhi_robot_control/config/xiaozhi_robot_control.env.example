# Copy this file to ~/.config/xiaozhi_robot_control/env and fill MCP_ENDPOINT.
# xiaozhi-diablo-startup reads runtime configuration only from that file.
#
# Required:
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN

# Runtime defaults. Keep each robot in a different ROS_DOMAIN_ID when multiple
# robots are on the same LAN, otherwise one MotionCmd can be received by all.
DIABLO_ROBOT_NAME=robot1
ROS_DOMAIN_ID=51
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/home/diablo/diablo_ws/src/xiaozhi_robot_control/config/fastdds_udp_only.xml
DIABLO_WS=/home/diablo/diablo_ws
DIABLO_ENABLE_POSTURE_TOOLS=true

# Enable only on robot1. The dispatcher keeps one persistent worker per
# ROS_DOMAIN_ID and fans out cluster commands through those workers.
DIABLO_ENABLE_CLUSTER_TOOLS=true
DIABLO_CLUSTER_ROS_DOMAIN_IDS=51,52,53
DIABLO_CLUSTER_ROBOT_NAMES=robot1,robot2,robot3
DIABLO_CLUSTER_PRESTART=true
DIABLO_CLUSTER_CALL_RETRY_COUNT=2
DIABLO_CLUSTER_WORKER_RESTART_ATTEMPTS=2
DIABLO_CLUSTER_WORKER_TIMEOUT_EXTRA_SEC=8
DIABLO_CLUSTER_REQUIRE_SUBSCRIBER=true
DIABLO_CLUSTER_REQUIRE_ALL_READY=true
DIABLO_CLUSTER_READY_RETRY_COUNT=3
DIABLO_WAIT_FOR_SUBSCRIBER_MS=15000
DIABLO_DISCOVERY_SETTLE_MS=2000

# Motion limits.
DIABLO_MAX_LINEAR_SPEED=0.5
DIABLO_MAX_TURN_SPEED=0.8
DIABLO_DEFAULT_LINEAR_SPEED=0.5
DIABLO_DEFAULT_TURN_SPEED=0.6
DIABLO_MAX_DURATION_MS=2000
DIABLO_MIN_DURATION_MS=1000
DIABLO_DEFAULT_DURATION_MS=1200
DIABLO_DEFAULT_UP=0.0

# Body posture controls.
DIABLO_MAX_VERTICAL_SPEED=1.0
DIABLO_DEFAULT_VERTICAL_SPEED=0.5
DIABLO_STAND_UP_HEIGHT=1.0
DIABLO_STAND_UP_HEIGHT_PUBLISH_MS=1200
DIABLO_MAX_PITCH=0.5
DIABLO_DEFAULT_PITCH=0.5
DIABLO_MAX_ROLL=0.1
DIABLO_DEFAULT_ROLL=0.1
