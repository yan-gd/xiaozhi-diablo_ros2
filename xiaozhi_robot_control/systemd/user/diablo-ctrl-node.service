[Unit]
Description=DIABLO ROS2 control node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/diablo/diablo_ws/src/xiaozhi_robot_control
Environment=DIABLO_WS=/home/diablo/diablo_ws
ExecStart=/home/diablo/diablo_ws/src/xiaozhi_robot_control/scripts/run_diablo_ctrl_node_udp.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
