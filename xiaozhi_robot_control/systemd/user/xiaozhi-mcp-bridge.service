[Unit]
Description=Xiaozhi MCP bridge for DIABLO robot
Wants=network-online.target diablo-ctrl-node.service
After=network-online.target diablo-ctrl-node.service

[Service]
Type=simple
WorkingDirectory=/home/diablo/diablo_ws/src/xiaozhi_robot_control
Environment=DIABLO_WS=/home/diablo/diablo_ws
EnvironmentFile=%h/.config/xiaozhi_robot_control/env
ExecStart=/home/diablo/diablo_ws/src/xiaozhi_robot_control/scripts/run_with_xiaozhi_endpoint.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
